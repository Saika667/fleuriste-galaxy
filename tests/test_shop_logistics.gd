extends RefCounted
var t
func test_empty_start_and_physical_delivery() -> void:
	var g=t.new_game();g.new_game(11,false)
	t.eq(g.rooms.shop.items.size(),0,"nouvelle partie : aucun meuble offert")
	t.eq(g.economy.legit,300,"budget du tutoriel")
	var r=g.logistics.order("counter")
	t.check(r.ok,"commande du comptoir")
	t.eq(g.economy.legit,250,"paiement dans le téléphone")
	t.eq(g.logistics.owned.size(),0,"aucun meuble utilisable avant déballage")
	var opened=g.logistics.unpack(r.order)
	t.check(opened.ok,"déballage du carton")
	t.eq(opened.items.size(),1,"un comptoir récupéré")
	t.check(not g.logistics.unpack(r.order).ok,"double ouverture interdite")
	t.eq(g.logistics.owned.size(),1,"pas de duplication")
	t.check(g.logistics.place(opened.items[0],Vector3(2,0,4),.25,"shop").ok,"placement continu")
	t.eq(g.logistics.count_role("counter"),1,"comptoir présent après placement")
	var snapshot=g.to_dict();var restored=t.new_game();restored.from_dict(snapshot)
	t.eq(restored.logistics.owned,g.logistics.owned,"objets et positions sauvegardés")
	t.eq(restored.logistics.orders,g.logistics.orders,"livraisons sauvegardées")
	g.free();restored.free()
func test_locked_articles_and_funds() -> void:
	var g=t.new_game();g.new_game(12,false);var before=g.economy.legit
	t.check(not g.logistics.order("flower:xeno_bloom",1).ok,"niveau requis vérifié côté logique")
	t.check(not g.logistics.order("grow_bed",1).ok,"darknet fermé avant découverte de la cave")
	t.check(not g.logistics.order("counter",0).ok,"quantité nulle refusée")
	t.check(not g.logistics.order("counter",99).ok,"commande trop chère refusée")
	t.eq(g.economy.legit,before,"aucune facturation après refus")
	t.eq(g.logistics.orders.size(),0,"aucun carton après refus")
	g.free()
func test_flower_pots_crafting_and_paper_length() -> void:
	var g=t.new_game();g.new_game(13,false)
	var order=g.logistics.order("flower_pot:rose");var opened=g.logistics.unpack(order.order);var uid=opened.items[0]
	g.logistics.place(uid,Vector3(1,1.8,1),0,"shop")
	g.inventory.add("rose",6,2,.85)
	t.check(g.logistics.fill_pot(uid,"rose").ok,"remplissage du pot")
	t.eq(g.inventory.total("rose"),0,"les fleurs du pot sortent du stock libre")
	t.eq(g.vases.stems("free|"+uid).size(),6,"six tiges dans le pot")
	g.inventory.add("rose",2,2,.2)
	var short_b=g.logistics.compose_from_pots([{"pot":uid}],"paper",.3)
	var long_b=g.logistics.compose_from_pots([{"pot":uid}],"paper",1.5)
	t.check(short_b!=null and long_b!=null,"composition depuis les vrais pots")
	t.eq(g.inventory.total("rose"),2,"le bouquet consomme le pot sélectionné, pas les autres lots")
	t.eq(g.vases.stems("free|"+uid).size(),4,"une tige consommée par bouquet")
	t.check(long_b.cost()>short_b.cost(),"longueur de papier prise en compte dans le coût")
	t.check(long_b.price>short_b.price,"longueur de papier prise en compte dans le prix")
	t.check(is_equal_approx(short_b.stems[0].freshness,.85),"fraîcheur conservée")
	var before=g.to_dict()
	t.check(g.logistics.compose_from_pots([{"pot":"missing"}],"paper",.6)==null,"pot inexistant refusé")
	t.eq(g.inventory.to_dict(),before.inventory,"échec sans consommer l’inventaire")
	t.eq(g.vases.to_dict(),before.vases,"échec sans consommer les pots")
	var saved=Bouquet.from_dict(long_b.to_dict());t.check(is_equal_approx(saved.paper_length,1.5),"longueur de papier sauvegardée")
	g.free()

func test_seed_growth_and_free_station_navigation() -> void:
	var g=t.new_game();g.new_game(14,false)
	var r=g.logistics.order("nursery_pot");var uid=g.logistics.unpack(r.order).items[0]
	g.logistics.place(uid,Vector3(2,0,2),0,"shop");g.logistics.flower_seeds.rose=1
	t.check(g.logistics.plant_flower(uid,"rose").ok,"semis dans un pot individuel")
	t.check(not g.logistics.harvest_flower(uid).ok,"récolte prématurée refusée")
	g.logistics.tick(400)
	t.check(g.logistics.harvest_flower(uid).ok,"récolte après croissance")
	t.eq(g.inventory.total("rose"),3,"trois tiges récoltées")
	r=g.logistics.order("counter");uid=g.logistics.unpack(r.order).items[0];g.logistics.place(uid,Vector3(6.5,0,5.5),.2,"shop")
	t.eq(g.logistics.shop_stations().size(),1,"comptoir libre reconnu comme poste de travail")
	t.eq(g.logistics.shop_stations()[0].center,Vector3(6.5,0,5.5),"position exacte conservée pour la file")
	t.check(not g.logistics.shop_obstacles().is_empty(),"mobilier libre inclus dans la navigation")
	g.free()
